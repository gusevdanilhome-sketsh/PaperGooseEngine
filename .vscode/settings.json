{
    // ====================================================================
    //  ТЕМЫ И ОФОРМЛЕНИЕ
    // ====================================================================
    "workbench.iconTheme": "gruvbox-material-icon-theme",
    "workbench.colorTheme": "Material Night Eighties",
    "material-icon-theme.activeIconPack": "angular_ngrx",
    "material-icon-theme.hidesExplorerArrows": true,
    "material-icon-theme.showWelcomeMessage": false,
    "material-icon-theme.showReloadMessage": false,
    "workbench.colorCustomizations": {
        "errorLens.errorBackground": "#e4545422",
        "errorLens.errorForeground": "#ff8080",
        "errorLens.warningBackground": "#ff942f22",
        "errorLens.warningForeground": "#ffb870",
        "errorLens.infoBackground": "#00b7e422",
        "errorLens.infoForeground": "#80d8ff",
        "errorLens.hintBackground": "#17a2a222",
        "errorLens.hintForeground": "#80c080"
    },

    // ====================================================================
    //  ОБЩИЕ НАСТРОЙКИ РЕДАКТОРА
    // ====================================================================
    "editor.cursorSmoothCaretAnimation": "on",
    "editor.cursorBlinking": "expand",
    "editor.cursorStyle": "line",
    "editor.cursorWidth": 0,
    "editor.fontFamily": "Consolas",
    "editor.fontSize": 16,
    "editor.fontWeight": "normal",
    "editor.overviewRulerBorder": true,
    "editor.showFoldingControls": "mouseover",
    "editor.foldingStrategy": "indentation",
    "editor.bracketPairColorization.enabled": true,
    "editor.renderWhitespace": "none",
    "editor.quickSuggestionsDelay": 0,
    "explorer.confirmDelete": false,
    "files.autoSave": "afterDelay",
    "files.autoSaveDelay": 1000,
    "editor.rulers": [
        {
            "column": 80,
            "color": "#35ff0d"
        },
        {
            "column": 120,
            "color": "#ff0000"
        }
    ],

    // ====================================================================
    //  C/C++ ИНСТРУМЕНТЫ
    // ====================================================================
    "C_Cpp.intelliSenseEngine": "default",
    "C_Cpp.autocompleteAddParentheses": true,

    // ====================================================================
    //  CMAKE-ИНСТРУМЕНТЫ (адаптировано под PaperGoose)
    // ====================================================================
    "cmake.generator": "MinGW Makefiles",
    "cmake.configureSettings": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": true
    },
    "cmake.buildDirectory": "${workspaceFolder}/build",
    "cmake.additionalCompilerSearchDirs": [
        "C:/msys64/mingw64/bin",
        "C:/msys64/clang64/bin",
        "C:/msys64/ucrt64/bin"
    ],

    // ====================================================================
    //  CLANG-ИНСТРУМЕНТЫ (пути под MSYS2 MinGW)
    // ====================================================================
    "clang-format.executable": "C:\\msys64\\mingw64\\bin\\clang-format.exe",
    "clang-tidy.executable": "C:\\msys64\\mingw64\\bin\\clang-tidy.exe",
    "clang-tidy.buildPath": "${workspaceFolder}/build",
    "clang-tidy.checks": [
        "readability-braces-around-statements",
        "readability-isolate-declaration"
    ],
    "clang-tidy.fixOnSave": true,
    "clang-tidy.compilerArgs": [
        "-std=c17",
        "-I./src"
    ],

    // ====================================================================
    //  НАСТРОЙКИ ФОРМАТИРОВАНИЯ ПРИ СОХРАНЕНИИ
    // ====================================================================
    "[cpp]": {
        "editor.defaultFormatter": "xaver.clang-format",
        "editor.formatOnSave": true
    },
    "[c]": {
        "editor.defaultFormatter": "xaver.clang-format",
        "editor.formatOnSave": true
    },

    // ====================================================================
    //  ERROR LENS (usernamehw.errorlens)
    // ====================================================================
    "errorLens.enabled": true,
    "errorLens.enabledDiagnosticLevels": ["error", "warning"],
    "errorLens.fontSize": "-1px",
    "errorLens.margin": "2ch",
    "errorLens.messageBackgroundMode": "line",
    "errorLens.removeLinebreaks": true,
    "errorLens.statusBarIconsEnabled": true,
    "errorLens.statusBarMessageEnabled": true,
    "errorLens.statusBarMessageType": "activeLine",
    "errorLens.gutterIconsEnabled": true,
    "errorLens.gutterIconSet": "default",
    "errorLens.delay": 0,
    "errorLens.followCursor": "allLines",

    // ====================================================================
    //  DOXYGEN DOCUMENTATION GENERATOR (cschlosser.doxdocgen)
    // ====================================================================
    "doxdocgen.generic.useGitUserName": true,
    "doxdocgen.generic.useGitUserEmail": true,
    "doxdocgen.generic.authorName": "Гусев Данил Олегович",
    "doxdocgen.generic.authorEmail": "GusevDanil-HOME@yandex.ru",
    "doxdocgen.c.firstLine": "/**",
    "doxdocgen.c.lastLine": " */",
    "doxdocgen.c.commentPrefix": " * ",
    "doxdocgen.c.triggerSequence": "/**",
    "doxdocgen.generic.generateSmartText": true,
    "doxdocgen.generic.splitCasingSmartText": true,
    "doxdocgen.generic.boolReturnsTrueFalse": true,
    "doxdocgen.generic.includeTypeAtReturn": true,
    "doxdocgen.generic.linesToGet": 20,
    "doxdocgen.generic.briefTemplate": "@brief {text}",
    "doxdocgen.generic.paramTemplate": "@param {param} ",
    "doxdocgen.generic.returnTemplate": "@return {type} ",
    "doxdocgen.cpp.tparamTemplate": "@tparam {param} ",
    "doxdocgen.cpp.ctorText": "Создать объект {name}",
    "doxdocgen.cpp.dtorText": "Уничтожить объект {name}",
    "doxdocgen.c.factoryMethodText": "Создать объект {name}",
    "doxdocgen.c.getterText": "Получить {name}",
    "doxdocgen.c.setterText": "Задать {name}",
    "doxdocgen.file.fileOrder": [
        "file", "author", "brief", "version", "date", "empty", "copyright", "empty", "custom"
    ],
    "doxdocgen.file.fileTemplate": "@file {name}",
    "doxdocgen.file.versionTag": "@version 0.1",
    "doxdocgen.generic.dateFormat": "YYYY-MM-DD",
    "doxdocgen.generic.dateTemplate": "@date {date}",
    "doxdocgen.generic.authorTag": "@author {author} ({email})",
    "doxdocgen.file.copyrightTag": ["@copyright Copyright (c) {year}"],
    "doxdocgen.generic.order": [
        "brief", "empty", "tparam", "param", "return", "custom",
        "version", "author", "date", "copyright"
    ],
    "doxdocgen.generic.commandSuggestion": true,
    "doxdocgen.generic.commandSuggestionAddPrefix": false,

    // ====================================================================
    //  TODO TREE (Gruntfuggly.todo-tree)
    // ====================================================================
    "todo-tree.general.tags": [
        "TODO", "FIXME", "BUG", "HACK", "XXX", "NOTE", "OPTIMIZE", "REVIEW"
    ],
    "todo-tree.general.statusBar": "tags",
    "todo-tree.general.statusBarClickBehaviour": "reveal",
    "todo-tree.general.showIconsInsteadOfTagsInStatusBar": true,
    "todo-tree.general.showActivityBarBadge": true,
    "todo-tree.highlights.useColourScheme": true,
    "todo-tree.highlights.backgroundColourScheme": [
        "#e06c75", "#d19a66", "#e5c07b", "#98c379",
        "#56b6c2", "#61afef", "#c678dd", "#abb2bf"
    ],
    "todo-tree.highlights.foregroundColourScheme": [
        "#ffffff", "#000000", "#000000", "#000000",
        "#000000", "#000000", "#ffffff", "#000000"
    ],
    "todo-tree.highlights.defaultHighlight": {
        "type": "line"
    },
    "todo-tree.tree.showIconsInsteadOfTagsInTree": true,
    "todo-tree.highlights.customHighlight": {
        "TODO": { "icon": "checklist", "iconColour": "#e06c75" },
        "FIXME": { "icon": "flame", "iconColour": "#d19a66" },
        "BUG": { "icon": "bug", "iconColour": "#e5c07b" },
        "HACK": { "icon": "tools", "iconColour": "#98c379" },
        "XXX": { "icon": "alert", "iconColour": "#56b6c2" },
        "NOTE": { "icon": "note", "iconColour": "#61afef" },
        "OPTIMIZE": { "icon": "rocket", "iconColour": "#c678dd" },
        "REVIEW": { "icon": "eye", "iconColour": "#abb2bf" }
    },
    "todo-tree.filtering.excludeGlobs": [
        "**/build/**", "**/.git/**", "**/dist/**", "**/out/**"
    ],
    "todo-tree.tree.scanMode": "workspace",
    "todo-tree.tree.hideTreeWhenEmpty": false,
    "todo-tree.tree.grouped": true,
    "todo-tree.tree.buttons.viewStyle": true,
    "todo-tree.tree.buttons.groupByTag": true,
    "todo-tree.tree.buttons.filter": true,
    "todo-tree.tree.buttons.refresh": true,
    "todo-tree.tree.buttons.export": true,
    "todo-tree.tree.labelFormat": "${tag} ${after}",
    "todo-tree.tree.tooltipFormat": "${filepath}, ${line}",
    "todo-tree.general.revealBehaviour": "start of line",

    // ====================================================================
    //  ТЕРМИНАЛ (MSYS2 bash по умолчанию)
    // ====================================================================
    "terminal.integrated.profiles.windows": {
        "PowerShell": {
            "source": "PowerShell",
            "icon": "terminal-powershell"
        },
        "Command Prompt": {
            "path": ["${env:windir}\\Sysnative\\cmd.exe", "${env:windir}\\System32\\cmd.exe"],
            "args": [],
            "icon": "terminal-cmd"
        },
        "Git Bash": {
            "source": "Git Bash",
            "icon": "terminal-git-bash"
        },
        "bash (MSYS2)": {
            "path": "C:\\msys64\\usr\\bin\\bash.exe",
            "args": ["--login", "-i"],
            "env": {
                "CHERE_INVOKING": "1"
            }
        }
    },
    "terminal.integrated.defaultProfile.windows": "bash (MSYS2)",

    // ====================================================================
    //  ПРОЧИЕ УДОБСТВА
    // ====================================================================
    "git.enableSmartCommit": true,
    "explorer.confirmDragAndDrop": false,
    "workbench.editorAssociations": {
        "*.copilotmd": "vscode.markdown.preview.editor"
    },
    "cmake.configureOnOpen": true,
    "cmake.buildBeforeRun": true
}